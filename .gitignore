# Dependencies
node_modules/
.pnp
.pnp.js

# Package manager files (keep package-lock.json for CI/CD)
# package-lock.json
yarn.lock
pnpm-lock.yaml

# Testing — keep in sync with the ignore lists in .prettierignore,
# .gitleaks.toml and eslint.config.mjs (all cover the same generated dirs).
coverage/
test-results/
playwright-report/
blob-report/

# Next.js
.next/
out/

# Production
build/
dist/

# Misc
.DS_Store
*.pem
.venv/

# Generated QR artifact — encodes the real store URL; never track it
# (identifier hygiene, ADR 00-007). Regenerate via scripts/generate_qr.sh.
qr_holyfans.svg

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env files — all real env files stay untracked (secrets and the public
# base URL live in the Hosting Platform's env config); only the template
# .env.example is tracked. Implements ADR 00-007: "secrets exist only as
# environment variables ... never in tracked files".
.env
.env.*
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# ADR review reports — generated audit output, not source
docs/adr-reports/

# Local tooling scripts — QR generator, IDE launcher; not repo source
scripts/
