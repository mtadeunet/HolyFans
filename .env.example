# ─────────────────────────────────────────────────────────────────────────────
# HolyFans — environment variables template
#
# Copy to `.env.local` for development, or set each key in the Vercel dashboard
# (Project Settings → Environment Variables) for Preview / Production.
# Never commit real values — all `.env*` files except this template are
# gitignored; real values live only in the Vercel dashboard and untracked
# local env files (ADR 00-007).
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL used in absolute links, SEO, etc.
NEXT_PUBLIC_BASE_URL=

# ── Purchase-surface gate (interim, plan M0) ─────────────────────────────────
# Fail-closed switch for the checkout page and every CTA that links to it.
# While the checkout submit is simulated (until the real Hosted Checkout in
# M3), the surface must stay hidden in production. Only the literal value
# `true` enables it — unset/empty/other values keep it closed. Set `true`
# only in non-production environments to develop/verify the checkout flow;
# removed at M4 launch.
PURCHASE_SURFACE_ENABLED=

# ── Edge Config (site-config / admin toggles) ────────────────────────────────
# Connection string auto-injected by Vercel when an Edge Config store is
# attached to the project. Used by `@vercel/edge-config` for reads.
EDGE_CONFIG=

# Bare Edge Config id (ecfg_xxxxxxxx). Used by the admin UI for REST writes.
VERCEL_EDGE_CONFIG_ID=

# Personal/team API token with Edge Config write scope.
# Create at https://vercel.com/account/tokens
VERCEL_API_TOKEN=

# Only required when the Edge Config lives under a team (not a personal account).
VERCEL_TEAM_ID=

# ── Admin route ──────────────────────────────────────────────────────────────
# Password for HTTP Basic Auth on `/admin`. Any username is accepted.
ADMIN_PASSWORD=

# ── Stripe (Hosted Checkout, M3 — key names only, never values) ──────────────
# Secret API key — server-side only, used by the checkout Route Handler.
# A restricted key (`rk_...`) scoped to Checkout Session write is preferred.
# Test mode (`sk_test_...`/`rk_test_...`) until launch; live key set in
# platform env only.
STRIPE_SECRET_KEY=
# Stripe Price IDs per Variant (created in the Stripe catalog — different
# ids per mode). When unset the handler falls back to inline price_data.
STRIPE_PRICE_ID_FEMALE=

# ── Social profiles ────────────────────────────────────────────────────────
# Instagram display handle (shown as "@<handle>" on the social-proof grid)
# and profile URL (Follow button + footer icon). Real values live in Vercel
# env or untracked local env files — never in tracked files (ADR 00-007).
NEXT_PUBLIC_INSTAGRAM_HANDLE=
NEXT_PUBLIC_INSTAGRAM_URL=

# ── WhatsApp ───────────────────────────────────────────────────────────────
# Store Messaging Number for the floating WhatsApp chat bubble (ADR 00-009).
# Digits-only international format — country code + subscriber number, no
# `+`, spaces, or punctuation (e.g. `351XXXXXXXXX`). Public client-side
# configuration, inlined at build time. When unset or empty the bubble
# renders nothing — fail-closed. Real value lives in platform env or
# untracked local env files only — never a real number here (ADR 00-007).
NEXT_PUBLIC_WHATSAPP_NUMBER=
